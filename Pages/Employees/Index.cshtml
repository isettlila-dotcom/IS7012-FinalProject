@page
@model IS7012_FinalProject.Pages.Employees.IndexModel

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p>
    <a asp-page="./Create" class="btn btn-primary">Add Employee</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Employee Number</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Hire Date</th>
            <th>Department</th>
            <th>Job Role</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model.Employees)
        {
            <tr>
                <td>@employee.EmployeeNumber</td>
                <td>@employee.FirstName</td>
                <td>@employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.HireDate.ToShortDateString()</td>
                <td>@employee.Department?.Name</td>
                <td>@employee.JobRole?.Title</td>
                <td>
                    @if (employee.IsActive)
                    {
                        <span>Yes</span>
                    }
                    else
                    {
                        <span>No</span>
                    }
                </td>

                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@employee.Id">
                        Edit
                    </a>

                    |

                    <a asp-page="./Details"
                       asp-route-id="@employee.Id">
                        Details
                    </a>

                    |

                    <a asp-page="./Delete"
                       asp-route-id="@employee.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>