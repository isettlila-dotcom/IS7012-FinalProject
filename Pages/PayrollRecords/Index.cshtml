@page
@model IS7012_FinalProject.Pages.PayrollRecords.IndexModel
@using IS7012_FinalProject.Models

@{
    ViewData["Title"] = "Payroll Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Payroll Records</h1>

    <a asp-page="Create" class="btn btn-primary">
        Create New Payroll Record
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning">
        @TempData["WarningMessage"]
    </div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle app-table payroll-table mb-0">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Period</th>
                    <th class="text-end text-nowrap">Basic</th>
                    <th class="text-end text-nowrap">Allowance</th>
                    <th class="text-end text-nowrap">Add'l Earnings</th>
                    <th class="text-end text-nowrap">Gross</th>
                    <th class="text-end text-nowrap">Deductions</th>
                    <th class="text-end text-nowrap">Net Pay</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.PayrollRecord)
                {
                    <tr>
                        <td class="text-nowrap">
                            @item.Employee?.FirstName @item.Employee?.LastName
                        </td>

                        <td class="text-nowrap">
                            @item.PayrollPeriod?.StartDate.ToString("MMM yyyy")
                        </td>

                        <td class="text-end">
                            @(item.SalaryPackage?.BasicSalary.ToString("N2") ?? "-")
                        </td>

                        <td class="text-end">
                            @(item.SalaryPackage?.Allowance.ToString("N2") ?? "-")
                        </td>

                        <td class="text-end">
                            @item.AdditionalEarnings.ToString("N2")
                        </td>

                        <td class="text-end">
                            @item.GrossPay.ToString("N2")
                        </td>

                        <td class="text-end">
                            @item.Deductions.ToString("N2")
                        </td>

                        <td class="text-end fw-semibold">
                            @item.NetPay.ToString("N2")
                        </td>

                        <td>
                            @switch (item.Status)
                            {
                                case PayrollStatus.Draft:
                                    <span class="badge bg-secondary">Draft</span>
                                    break;

                                case PayrollStatus.Submitted:
                                    <span class="badge bg-primary">Submitted</span>
                                    break;

                                case PayrollStatus.Approved:
                                    <span class="badge bg-success">Approved</span>
                                    break;

                                case PayrollStatus.Returned:
                                    <span class="badge bg-warning text-dark">Returned</span>
                                    break;
                            }
                        </td>

                        <td class="text-nowrap">
                            @if (item.Status == PayrollStatus.Draft ||
                                 item.Status == PayrollStatus.Returned)
                            {
                                <div>
                                    <a asp-page="./Edit"
                                       asp-route-id="@item.PayrollRecordId">
                                        Edit
                                    </a>
                                    <span class="text-muted"> | </span>

                                    <a asp-page="./Details"
                                       asp-route-id="@item.PayrollRecordId">
                                        Details
                                    </a>
                                    <span class="text-muted"> | </span>

                                    <a asp-page="./Delete"
                                       asp-route-id="@item.PayrollRecordId">
                                        Delete
                                    </a>
                                </div>

                                <form method="post"
                                      asp-page-handler="Submit"
                                      asp-route-id="@item.PayrollRecordId"
                                      class="mt-2">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-warning">
                                        Submit for Review
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-page="./Details"
                                   asp-route-id="@item.PayrollRecordId">
                                    Details
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>