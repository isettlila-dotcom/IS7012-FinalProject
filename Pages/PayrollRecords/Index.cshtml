@page
@model IS7012_FinalProject.Pages.PayrollRecords.IndexModel
@using IS7012_FinalProject.Models

@{
    ViewData["Title"] = "Payroll Records";
}

<h1>Payroll Records</h1>
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">
        @errorMessage
    </div>
}

<p>
    <a asp-page="Create">Create New Payroll Record</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Payroll Period</th>
            <th>Basic Salary</th>
            <th>Allowance</th>
            <th>Additional Earnings</th>
            <th>Gross Pay</th>
            <th>Deductions</th>
            <th>Net Pay</th>
            <th>Status</th>
            <th>Prepared Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.PayrollRecord)
        {
            <tr>
                <td>
                    @item.Employee?.FirstName @item.Employee?.LastName
                </td>

                <td>
                    @item.PayrollPeriod?.PeriodName
                </td>

                <td>
                    @item.SalaryPackage?.BasicSalary.ToString("N2")
                </td>

                <td>
                    @item.SalaryPackage?.Allowance.ToString("N2")
                </td>

                <td>
                    @item.AdditionalEarnings.ToString("N2")
                </td>
                <td>
                    @item.GrossPay.ToString("N2")
                </td>
                <td>
                    @item.Deductions.ToString("N2")
                </td>

                <td>
                    @item.NetPay.ToString("N2")
                </td>

                <td>
                    @item.Status
                </td>

                <td>
                    @item.PreparedDate?.ToString("dd-MMM-yyyy")
                </td>

                <td>
                    @if (item.Status == PayrollStatus.Draft ||
                         item.Status == PayrollStatus.Returned)
                    {
                        <a asp-page="./Edit"
                           asp-route-id="@item.PayrollRecordId">Edit</a>

                        <span> | </span>

                        <a asp-page="./Details"
                           asp-route-id="@item.PayrollRecordId">Details</a>

                        <span> | </span>

                        <a asp-page="./Delete"
                           asp-route-id="@item.PayrollRecordId">Delete</a>

                        <form method="post"
                              asp-page-handler="Submit"
                              asp-route-id="@item.PayrollRecordId"
                              class="d-inline">

                            <span> | </span>

                            <button type="submit"
                                    class="btn btn-link p-0 align-baseline">
                                Submit for Review
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-page="./Details"
                           asp-route-id="@item.PayrollRecordId">Details</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>