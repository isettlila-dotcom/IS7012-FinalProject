@page
@model IS7012_FinalProject.Pages.PayrollRecords.DetailsModel

@{
    ViewData["Title"] =
        $"{Model.PayrollRecord.Employee?.FirstName} {Model.PayrollRecord.Employee?.LastName} - Payroll Details";
}

<div class="row">
    <div class="col-lg-8">

        <div class="mb-4">
            <h1 class="mb-1">Payroll Record Details</h1>

            <p class="text-muted mb-0">
                View payroll information and processing status.
            </p>
        </div>

        <div class="card mb-4">

            <div class="card-header">
                Payroll Information
            </div>

            <div class="card-body p-0">

                <table class="table align-middle mb-0">
                    <tbody>

                        <tr>
                            <th class="ps-3" style="width: 40%;">
                                Employee
                            </th>
                            <td>
                                @Model.PayrollRecord.Employee?.EmployeeNumber -
                                @Model.PayrollRecord.Employee?.FirstName
                                @Model.PayrollRecord.Employee?.LastName
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Payroll Period</th>
                            <td>
                                @Model.PayrollRecord.PayrollPeriod?.PeriodName
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Basic Salary</th>
                            <td>
                                @Model.PayrollRecord.SalaryPackage?.BasicSalary.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Allowance</th>
                            <td>
                                @Model.PayrollRecord.SalaryPackage?.Allowance.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Additional Earnings</th>
                            <td>
                                @Model.PayrollRecord.AdditionalEarnings.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Gross Pay</th>
                            <td class="fw-semibold">
                                @Model.PayrollRecord.GrossPay.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Deductions</th>
                            <td>
                                @Model.PayrollRecord.Deductions.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Net Pay</th>
                            <td class="fw-bold">
                                @Model.PayrollRecord.NetPay.ToString("N2")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Status</th>
                            <td>
                                @switch (Model.PayrollRecord.Status)
                                {
                                    case IS7012_FinalProject.Models.PayrollStatus.Draft:
                                        <span class="badge bg-secondary">Draft</span>
                                        break;

                                    case IS7012_FinalProject.Models.PayrollStatus.Submitted:
                                        <span class="badge bg-primary">Submitted</span>
                                        break;

                                    case IS7012_FinalProject.Models.PayrollStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;

                                    case IS7012_FinalProject.Models.PayrollStatus.Returned:
                                        <span class="badge bg-warning text-dark">Returned</span>
                                        break;
                                }
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Prepared Date</th>
                            <td>
                                @(Model.PayrollRecord.PreparedDate?.ToString("dd MMM yyyy") ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Reviewed Date</th>
                            <td>
                                @(Model.PayrollRecord.ReviewedDate?.ToString("dd MMM yyyy") ?? "-")
                            </td>
                        </tr>

                        <tr>
                            <th class="ps-3">Remarks</th>
                            <td>
                                @(string.IsNullOrWhiteSpace(Model.PayrollRecord.Remarks)
                                    ? "-"
                                    : Model.PayrollRecord.Remarks)
                            </td>
                        </tr>

                    </tbody>
                </table>

            </div>
        </div>

        <div>
            <a asp-page="./Index"
               class="btn btn-outline-secondary">
                Back to Payroll Records
            </a>
        </div>

    </div>
</div>